cmake_minimum_required(VERSION 3.20)

function(run_cli status pattern)
    execute_process(COMMAND "${SPEC}" ${ARGN}
        RESULT_VARIABLE actual OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 20)
    if(NOT actual STREQUAL "${status}" OR NOT "${stdout}${stderr}" MATCHES "${pattern}")
        message(FATAL_ERROR "Expected exit ${status}, /${pattern}/, got ${actual}: ${stdout}${stderr}")
    endif()
    set(RESULT "${stdout}" PARENT_SCOPE)
endfunction()

function(check_fixture response length expected_windows)
    string(STRIP "${response}" rows)
    string(REPLACE "\n" ";" rows "${rows}")
    list(LENGTH rows row_count)
    if(NOT row_count EQUAL 3)
        message(FATAL_ERROR "Expected a header and two measurements")
    endif()
    list(GET rows 1 baseline)
    list(GET rows 2 speculative)
    foreach(row baseline speculative)
        string(REPLACE "," ";" fields "${${row}}")
        list(GET fields 4 requests)
        list(GET fields 5 positions)
        list(GET fields 6 proposed)
        list(GET fields 7 accepted)
        list(GET fields 8 rejected)
        list(GET fields 10 elapsed)
        list(GET fields 13 prefix_tv)
        list(GET fields 14 windows)
        math(EXPR expected_tokens "256 * ${length}")

        if(NOT elapsed GREATER 0 OR NOT windows EQUAL expected_windows OR prefix_tv GREATER 0.30)
            message(FATAL_ERROR "Unexpected fixture metrics: ${${row}}")
        endif()
        if(row STREQUAL "baseline" OR length EQUAL 1)
            if(NOT requests EQUAL expected_tokens OR NOT positions EQUAL expected_tokens
               OR NOT proposed EQUAL 0 OR NOT accepted EQUAL 0 OR NOT rejected EQUAL 0)
                message(FATAL_ERROR "Unexpected unbatched accounting: ${${row}}")
            endif()
        else()
            if(NOT requests LESS expected_tokens OR NOT positions GREATER requests
               OR NOT proposed GREATER accepted OR NOT rejected GREATER 0)
                message(FATAL_ERROR "Expected accepted and rejected speculative work: ${${row}}")
            endif()
        endif()
    endforeach()
endfunction()

run_cli(0 "joint_prefix_tv" 256 128 4)
check_fixture("${RESULT}" 128 32256)
run_cli(0 "joint_prefix_tv" 256 1 4)
check_fixture("${RESULT}" 1 0)
run_cli(0 "autoregressive_fixture,1000,128,0")
run_cli(0 "usage:" --help)
run_cli(1 "usage:" 1 2 3 4)
run_cli(1 "integer out of range" wrong)
run_cli(1 "integer out of range" 10 0)
run_cli(1 "integer out of range" 10 30 65)
run_cli(1 "must be at most 1000000" 100000 4096 64)

if(SERVER_ENABLED)
    run_cli(1 "usage:" --server)
    run_cli(1 "usage:" --compare)
    run_cli(1 "distinct loopback server ports" --compare http://localhost:8080/ http://127.0.0.1:8080 prompt 64 2)
    run_cli(1 "integer out of range" --compare http://127.0.0.1:8080 http://127.0.0.1:8081 prompt 64 501)
    run_cli(1 "usage:" --server http://127.0.0.1:8080 prompt 3 --unknown)
    run_cli(1 "integer out of range" --server http://127.0.0.1:8080 prompt 16400)
    foreach(url "https://example.com:8080" "http://localhost:0" "http://127.0.0.1:65536" "http://localhost:abc")
        run_cli(1 "use a local llama-server URL" --server "${url}" prompt 3)
    endforeach()
else()
    run_cli(1 "rebuild with -DENABLE_LLAMA_SERVER=ON" --server)
    run_cli(1 "rebuild with -DENABLE_LLAMA_SERVER=ON" --compare)
endif()
